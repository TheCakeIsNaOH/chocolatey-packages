<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>vcxsrv</id>
    <title>VcXsrv Windows X Server</title>
    <version>21.1.16.1</version>
    <authors>marha</authors>
    <owners>TheCakeIsNaOH</owners>
    <summary>Windows X-server based on the xorg git sources.</summary>
    <description> 
Windows X-server based on the xorg git sources (like xming or cygwin's xwin), but compiled with Visual C++ 2012 Express Edition. Source code can also be compiled with VS2008, VS2008 Express Edition and VS2010 Express Edition, although current project and makefile are not fully compatible anymore.
    </description>
    <projectUrl>https://github.com/marchaesen/vcxsrv</projectUrl>
    <packageSourceUrl>https://github.com/TheCakeIsNaOH/chocolatey-packages/tree/master/vcxsrv</packageSourceUrl>
    <projectSourceUrl>https://github.com/marchaesen/vcxsrv</projectSourceUrl>
    <bugTrackerUrl>https://github.com/marchaesen/vcxsrv/issues</bugTrackerUrl>
    <tags>vcxsrv admin X11 XServer</tags>
    <copyright>2026 marha</copyright>
    <licenseUrl>https://github.com/marchaesen/vcxsrv/blob/7ca654bf54c45b42638b4a77930e5de6eab2c54f/COPYING</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <iconUrl>https://cdn.statically.io/gh/TheCakeIsNaOH/chocolatey-packages@d63cb8566c7566f120ea9f95762eda696aafef15/Icons/xorg.png</iconUrl>
    <releaseNotes>https://github.com/marchaesen/vcxsrv/releases</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
