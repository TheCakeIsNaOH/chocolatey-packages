  <metadata>
    <id>4k-video-downloader-plus</id>
    <version>26.3.5</version>
    <packageSourceUrl>https://github.com/TheCakeIsNaOH/chocolatey-packages/tree/master/4k-video-downloader-plus</packageSourceUrl>
    <owners>TheCakeIsNaOH</owners>
    <title>4K Video Downloader Plus (Install)</title>
    <authors>OpenMedia LLC</authors>
    <projectUrl>https://www.4kdownload.com/products/videodownloader-42</projectUrl>
    <iconUrl>https://cdn.statically.io/gh/TheCakeIsNaOH/chocolatey-packages@82f38153c68e7eaf283d70cc11284d5497d3716d/Icons/4kvideodownloaderplus.png</iconUrl>
